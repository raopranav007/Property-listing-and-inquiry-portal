# Server port
PORT=5000

# MongoDB connection string (local MongoDB or MongoDB Atlas).
# Leave empty in development to use an automatic in-memory MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27017/property_portal

# Secret used to sign admin login tokens (use a long random string)
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d

# First admin account (created automatically if it does not exist)
ADMIN_NAME=Agency Admin
ADMIN_EMAIL=admin@propertyportal.com
ADMIN_PASSWORD=admin123

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173
